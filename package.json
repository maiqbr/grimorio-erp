{
  "name": "grimorio-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "db:local": "wrangler d1 migrations apply grimorio-local --local --config wrangler.local.jsonc",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:integration": "node tests/integration.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src worker tests *.json *.jsonc *.ts index.html",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "postal-mime": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "3.9.7",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "5.0.1",
    "wrangler": "^4.30.0"
  }
}
