{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grimorio-erp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 */6 * * *", "0 3 * * *"] },
  "routes": [{ "pattern": "erp.example.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ACCESS_AUD": "REPLACE_WITH_CLOUDFLARE_ACCESS_AUD",
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "APP_ORIGIN": "https://erp.example.com",
    "MAIL_ENABLED": "false",
    "MAIL_DOMAIN": "example.com",
    "OWNER_EMAIL": "you@example.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "grimorio",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "grimorio-files" }]
}
